/// @title AgentWallet — ERC-4337 smart wallet with policy-constrained agent key
/// @notice STUB: every function reverts with NotImplemented(). P1 will implement.
contract AgentWallet {
    // ── Structs ──────────────────────────────────────────────────────────────

    struct Policy {
        uint256 maxPerTx;
        uint256 dailyLimit;
        uint48 validUntil;
    }

    // ── Events ───────────────────────────────────────────────────────────────

    event AgentSet(address agent);
    event AgentRevoked();
    event AgentExecuted(address target, uint256 value, bytes4 selector);
    event OwnerExecuted(address target, uint256 value);

    // ── Custom Errors ────────────────────────────────────────────────────────

    error NotImplemented();
    error NotAllowedTarget();
    error NotAllowedRecipient();
    error ExceedsPerTxLimit();
    error ExceedsDailyLimit();
    error PolicyExpired();
    error ForbiddenCall();
    error NotOwner();
    error NotAgent();

    // ── Owner-only functions ─────────────────────────────────────────────────

    /// @notice Set the agent address and its spending policy. Owner only.
    function setAgent(address _agent, Policy calldata policy) external {
        revert NotImplemented();
    }

    /// @notice Revoke the current agent. Owner only.
    function revokeAgent() external {
        revert NotImplemented();
    }

    /// @notice Allow or disallow a target+selector pair for the agent. Owner only.
    function setAllowedTarget(address target, bytes4 selector, bool allowed) external {
        revert NotImplemented();
    }

    /// @notice Allow or disallow a recipient address for the agent. Owner only.
    function setAllowedRecipient(address recipient, bool allowed) external {
        revert NotImplemented();
    }

    // ── Execution functions ──────────────────────────────────────────────────

    /// @notice Execute a call as the agent. Policy-constrained. Called via EntryPoint.
    function executeAsAgent(address target, uint256 value, bytes calldata data) external {
        revert NotImplemented();
    }

    /// @notice Execute a call as the owner. Unrestricted.
    function execute(address target, uint256 value, bytes calldata data) external {
        revert NotImplemented();
    }

    // ── View functions ───────────────────────────────────────────────────────

    /// @notice Get the current agent spending policy.
    function getPolicy() external view returns (Policy memory) {
        revert NotImplemented();
    }

    /// @notice Get the amount spent by the agent today.
    function spentToday() external view returns (uint256) {
        revert NotImplemented();
    }

    /// @notice Get the current agent address.
    function agent() external view returns (address) {
        revert NotImplemented();
    }

    /// @notice Get the wallet owner address.
    function owner() external view returns (address) {
        revert NotImplemented();
    }
}
